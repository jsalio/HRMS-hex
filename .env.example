# PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hrms_dev
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/hrms_test

# JWT — generate with: openssl rand -hex 32
# Minimum 256 bits (64 hex chars). NEVER commit the real value.
JWT_SECRET=change_me_minimum_64_hex_characters_here_use_openssl_rand_hex_32

# JWT expiry
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# API
PORT=3000
NODE_ENV=development
